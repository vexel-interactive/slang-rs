// Wide bit operations verify both halves, signed searches, vectors and default arguments.
RWStructuredBuffer<uint> output;
uint resultType(uint value){return 1;}
uint resultType(uintptr_t value){return 2;}
uint readDefault(uint value=countbits(0x8000000000000001UZ)){return value;}
[shader("compute")][numthreads(1,1,1)]void main()
{
    uintptr_t u0=0x0UZ;
    uintptr_t u1=0x1UZ;
    uintptr_t u2=0x80000000UZ;
    uintptr_t u3=0x100000000UZ;
    uintptr_t u4=0x8000000000000000UZ;
    uintptr_t u5=0xffffffffffffffffUZ;
    uintptr_t u6=0x123456789abcdefUZ;
    intptr_t s0=0Z;
    intptr_t s1=-1Z;
    intptr_t s2=-2Z;
    intptr_t s3=-9223372036854775808Z;
    intptr_t s4=9223372036854775807Z;
    intptr_t s5=-81985529216486895Z;
    vector<uintptr_t,4> vectorValue=vector<uintptr_t,4>(0x8000000000000000UZ,0x100000000UZ,0UZ,0x0123456789abcdefUZ);
    uint4 counts=countbits(vectorValue);uint4 highs=firstbithigh(vectorValue);uint4 lows=firstbitlow(vectorValue);vector<uintptr_t,4> reversed=reversebits(vectorValue);
    uintptr_t state=0x8000000000000000UZ;
    output[0]=countbits(u0);
    output[1]=firstbithigh(u0);
    output[2]=firstbitlow(u0);
    output[3]=uint(reversebits(u0));
    output[4]=uint(reversebits(u0)>>32);
    output[5]=countbits(u1);
    output[6]=firstbithigh(u1);
    output[7]=firstbitlow(u1);
    output[8]=uint(reversebits(u1));
    output[9]=uint(reversebits(u1)>>32);
    output[10]=countbits(u2);
    output[11]=firstbithigh(u2);
    output[12]=firstbitlow(u2);
    output[13]=uint(reversebits(u2));
    output[14]=uint(reversebits(u2)>>32);
    output[15]=countbits(u3);
    output[16]=firstbithigh(u3);
    output[17]=firstbitlow(u3);
    output[18]=uint(reversebits(u3));
    output[19]=uint(reversebits(u3)>>32);
    output[20]=countbits(u4);
    output[21]=firstbithigh(u4);
    output[22]=firstbitlow(u4);
    output[23]=uint(reversebits(u4));
    output[24]=uint(reversebits(u4)>>32);
    output[25]=countbits(u5);
    output[26]=firstbithigh(u5);
    output[27]=firstbitlow(u5);
    output[28]=uint(reversebits(u5));
    output[29]=uint(reversebits(u5)>>32);
    output[30]=countbits(u6);
    output[31]=firstbithigh(u6);
    output[32]=firstbitlow(u6);
    output[33]=uint(reversebits(u6));
    output[34]=uint(reversebits(u6)>>32);
    output[35]=countbits(s0);
    output[36]=firstbithigh(s0);
    output[37]=firstbitlow(s0);
    output[38]=uint(reversebits(s0));
    output[39]=uint(reversebits(s0)>>32);
    output[40]=countbits(s1);
    output[41]=firstbithigh(s1);
    output[42]=firstbitlow(s1);
    output[43]=uint(reversebits(s1));
    output[44]=uint(reversebits(s1)>>32);
    output[45]=countbits(s2);
    output[46]=firstbithigh(s2);
    output[47]=firstbitlow(s2);
    output[48]=uint(reversebits(s2));
    output[49]=uint(reversebits(s2)>>32);
    output[50]=countbits(s3);
    output[51]=firstbithigh(s3);
    output[52]=firstbitlow(s3);
    output[53]=uint(reversebits(s3));
    output[54]=uint(reversebits(s3)>>32);
    output[55]=countbits(s4);
    output[56]=firstbithigh(s4);
    output[57]=firstbitlow(s4);
    output[58]=uint(reversebits(s4));
    output[59]=uint(reversebits(s4)>>32);
    output[60]=countbits(s5);
    output[61]=firstbithigh(s5);
    output[62]=firstbitlow(s5);
    output[63]=uint(reversebits(s5));
    output[64]=uint(reversebits(s5)>>32);
    output[65]=countbits(vectorValue.x);
    output[66]=firstbithigh(vectorValue.x);
    output[67]=firstbitlow(vectorValue.x);
    output[68]=uint(reversebits(vectorValue.x));
    output[69]=uint(reversebits(vectorValue.x)>>32);
    output[70]=countbits(vectorValue.y);
    output[71]=firstbithigh(vectorValue.y);
    output[72]=firstbitlow(vectorValue.y);
    output[73]=uint(reversebits(vectorValue.y));
    output[74]=uint(reversebits(vectorValue.y)>>32);
    output[75]=countbits(vectorValue.z);
    output[76]=firstbithigh(vectorValue.z);
    output[77]=firstbitlow(vectorValue.z);
    output[78]=uint(reversebits(vectorValue.z));
    output[79]=uint(reversebits(vectorValue.z)>>32);
    output[80]=countbits(vectorValue.w);
    output[81]=firstbithigh(vectorValue.w);
    output[82]=firstbitlow(vectorValue.w);
    output[83]=uint(reversebits(vectorValue.w));
    output[84]=uint(reversebits(vectorValue.w)>>32);
    output[85]=counts.x;
    output[86]=highs.x;
    output[87]=lows.x;
    output[88]=uint(reversed.x);
    output[89]=uint(reversed.x>>32);
    output[90]=counts.y;
    output[91]=highs.y;
    output[92]=lows.y;
    output[93]=uint(reversed.y);
    output[94]=uint(reversed.y>>32);
    output[95]=counts.z;
    output[96]=highs.z;
    output[97]=lows.z;
    output[98]=uint(reversed.z);
    output[99]=uint(reversed.z>>32);
    output[100]=counts.w;
    output[101]=highs.w;
    output[102]=lows.w;
    output[103]=uint(reversed.w);
    output[104]=uint(reversed.w>>32);
    output[105]=countbits(state++);
    output[106]=uint(state);
    output[107]=uint(state>>32);
    output[108]=readDefault();
    output[109]=resultType(countbits(state));
    output[110]=resultType(firstbithigh(state));
    output[111]=resultType(firstbitlow(state));
}
